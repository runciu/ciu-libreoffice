<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <!-- A top-level "CIU" menu, shown in Calc only for now. -->
    <node oor:name="OfficeMenuBar">
      <node oor:name="com.runciu.ciu.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value>CIU</value>
        </prop>
        <prop oor:name="Target" oor:type="xs:string">
          <value>_self</value>
        </prop>
        <node oor:name="Submenu">
          <node oor:name="m1" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string">
              <value>service:com.runciu.ciu.Assistant?open</value>
            </prop>
            <prop oor:name="Title" oor:type="xs:string">
              <value>Ask CIU about selection...</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
            <prop oor:name="Context" oor:type="xs:string">
              <value>com.sun.star.sheet.SpreadsheetDocument</value>
            </prop>
          </node>
          <node oor:name="m2" oor:op="replace">
            <prop oor:name="URL" oor:type="xs:string">
              <value>service:com.runciu.ciu.Assistant?status</value>
            </prop>
            <prop oor:name="Title" oor:type="xs:string">
              <value>Check CIU connection</value>
            </prop>
            <prop oor:name="Target" oor:type="xs:string">
              <value>_self</value>
            </prop>
            <prop oor:name="Context" oor:type="xs:string">
              <value>com.sun.star.sheet.SpreadsheetDocument</value>
            </prop>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
